POSTGRES_PASSWORD=change_this_to_a_strong_password

# Optional: only needed to connect app/db.py to Postgres directly (e.g. when
# running backend.py outside docker-compose, which builds this connection
# string itself from POSTGRES_PASSWORD). Leave unset to fall back to SQLite.
DATABASE_URL=postgresql://ecovision:change_this_to_a_strong_password@localhost:5432/ecovision

SECRET_KEY=
CORS_ORIGINS=http://127.0.0.1:3000

# First-run admin account bootstrapped into the devteam table -- required,
# app/db.py reads these directly (there is no other way to create the first
# devteam login).
DEVTEAM_BOOTSTRAP_USERNAME=devteam
DEVTEAM_BOOTSTRAP_PASSWORD=change_this_to_a_strong_password

NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_AI_URL=http://127.0.0.1:8001
