# EcoVision Sentinel -- environment template
#
# Copy to .env and fill in. Read by app/backend.py via load_dotenv()
# (backend.py:31).
#
# The AI core (maincode/main.py) does NOT read this file -- it is configured
# through config.json / config.<APP_ENV>.json at the repo root.
# The frontend does NOT read this file either -- Next.js reads .env.local
# from the REPO ROOT (see .env.local.example).

# ── Read by backend.py ───────────────────────────────────────────────────

# Selects config.<APP_ENV>.json, falling back to config.json.
APP_ENV=development

# Signs JWTs. Generate a real one for anything but local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it invalidates every issued token.
SECRET_KEY=

# Comma-separated CORS allowlist. localhost and 127.0.0.1 are different
# origins to the browser -- list both if you use both.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Database ─────────────────────────────────────────────────────────────
#
# UNSET (the default)  -> SQLite at %USERPROFILE%\EcoVisionSentinelData\ecovision.db
# SET                  -> Postgres
#
# db.py chooses on presence alone (db.py:17); there is no fallback if the
# connection fails, so setting this without a reachable server raises at
# import time.
#
# Caveat for local runs: backend.py imports db.py (line 27) BEFORE calling
# load_dotenv() (line 31), so a DATABASE_URL set in .env never reaches
# db.py. Export it in your real shell environment instead.
#
# DATABASE_URL=postgresql://ecovision:CHANGE_ME@localhost:5432/ecovision

# ── Optional overrides (all unset by default) ────────────────────────────
# Relocate the writable data root (db, logs, recordings, runtime_ports.json):
# ECOVISION_WRITABLE_DIR=
# Point at a specific SQLite file instead of the default location:
# SQLITE_PATH=
# RTSP URL for the camera seeded on first run only:
# SEED_CAMERA_1_URL=rtsp://user:pass@192.168.1.100:554/stream1
# Force the AI core's backend URL instead of reading runtime_ports.json:
# BACKEND_API_URL_OVERRIDE=

# What the AI core watches. Overrides camera.source/camera.index in
# config.json. A local device index, or any network stream -- RTSP is the
# interface effectively every CCTV vendor exposes, so an existing camera
# installation can be adopted without new hardware:
#   CAMERA_SOURCE=0
#   CAMERA_SOURCE=rtsp://user:pass@10.0.0.12:554/stream1
#   CAMERA_SOURCE=http://10.0.0.12/video.mjpg
# CAMERA_SOURCE=

# ONVIF PTZ camera for the dashboard's pan/tilt/zoom panel. Unset, the PTZ
# endpoints report "not configured" instead of failing. PTZ_CAMERA_USER/PASS
# are the camera's own "camera account", not a vendor cloud login.
# PTZ_CAMERA_HOST=
# PTZ_CAMERA_PORT=2020
# PTZ_CAMERA_USER=
# PTZ_CAMERA_PASS=

# If BOTH are set, the first DEVTEAM account is created with this exact
# username/password instead of a random one (backend.py's bootstrap block,
# and reset_devteam_password.py). Leave both unset here -- this is a real
# login credential, not a build-time default, so it belongs only in each
# deployer's own untracked .env, never in the committed template. Unset,
# the system falls back to the old behavior: a random password generated on
# first run, printed once and written to <writable dir>/devteam_credentials.txt.
DEVTEAM_BOOTSTRAP_USERNAME=
DEVTEAM_BOOTSTRAP_PASSWORD=
