# dockerfile.detector.build
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-detector.txt .
RUN pip install --no-cache-dir --upgrade pip setuptools wheel
RUN pip install --no-cache-dir -r requirements-detector.txt

COPY optimize_weights.py .
COPY weights/yolo11s-pose.pt weights/yolo11s-pose.pt
COPY weights/weapon_signs.pt weights/weapon_signs.pt

CMD ["python", "optimize_weights.py"]