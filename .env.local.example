# Next.js frontend environment template. Copy to .env.local at the REPO ROOT.
#
# Next.js loads .env.local from the directory it is started in (where
# package.json lives), not from app/. A copy under app/ is silently ignored.
#
# Read by app/hooks/useRuntimeConfig.ts and app/lib/runtime-config.ts, both
# of which already default to these values -- set them only if you run the
# backend or AI core on non-default ports.
#
# These are inlined at build time. The packaged Electron build negotiates
# ports at launch and reads runtime_ports.json instead.

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AI_URL=http://localhost:8001
