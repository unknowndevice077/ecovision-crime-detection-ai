# Dockerfile.combined
FROM node:20-slim AS frontend-deps
WORKDIR /frontend
COPY package.json ./
RUN npm install

FROM node:20-slim AS frontend-builder
WORKDIR /frontend
COPY --from=frontend-deps /frontend/node_modules ./node_modules
COPY . .
ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
RUN npm run build
RUN mkdir -p public

FROM python:3.11-slim AS final
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 curl gnupg supervisor \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# --- backend half ---
COPY requirements-backend.txt .
RUN pip install --no-cache-dir --upgrade pip setuptools wheel
RUN pip install --no-cache-dir -r requirements-backend.txt
COPY app/backend.py app/db.py app/schema_final.sql app/

# --- detector / AI core half ---
COPY requirements-detector.txt .
RUN pip install --no-cache-dir -r requirements-detector.txt \
    && pip uninstall -y opencv-python \
    && pip install --no-cache-dir --force-reinstall opencv-python-headless==4.13.0.92

COPY maincode/main.py maincode/main.py
COPY maincode/robbery_vandalism.py maincode/robbery_vandalism.py
COPY maincode/x3d_violence_detector.py maincode/x3d_violence_detector.py
COPY weights/x3d_xs_violence_best.pt weights/x3d_xs_violence_best.pt
COPY weights/yolo11s-pose.engine weights/yolo11s-pose.engine
COPY weights/weapon_signs.engine weights/weapon_signs.engine

# --- shared config -- copy ALL env variants, not just config.json ---
COPY config.json config.json
COPY config.production.json config.production.json
COPY config.development.json config.development.json

# --- frontend half (standalone Next.js output) ---
COPY --from=frontend-builder /frontend/public ./frontend/public
COPY --from=frontend-builder /frontend/.next/standalone ./frontend
COPY --from=frontend-builder /frontend/.next/static ./frontend/.next/static

RUN mkdir -p /var/log/supervisor
COPY <<'SUPERVISORCONF' /etc/supervisor/conf.d/ecovision.conf
[supervisord]
nodaemon=true
logfile=/var/log/supervisor/supervisord.log

[program:backend]
command=python /app/app/backend.py
directory=/app/app
autorestart=true
environment=APP_ENV="production"
stdout_logfile=/var/log/supervisor/backend.log
stderr_logfile=/var/log/supervisor/backend.err.log

[program:detector]
command=python /app/maincode/main.py
directory=/app/maincode
autorestart=true
environment=APP_ENV="production",BACKEND_API_URL_OVERRIDE="http://127.0.0.1:8000"
stdout_logfile=/var/log/supervisor/detector.log
stderr_logfile=/var/log/supervisor/detector.err.log

[program:frontend]
command=node /app/frontend/server.js
directory=/app/frontend
autorestart=true
stdout_logfile=/var/log/supervisor/frontend.log
stderr_logfile=/var/log/supervisor/frontend.err.log
environment=PORT=3000
SUPERVISORCONF

EXPOSE 8000 8001 3000
CMD ["supervisord", "-c", "/etc/supervisor/conf.d/ecovision.conf"]