{
  "system": {
    "name": "EcoVision Security Sentinel",
    "version": "2.0",
    "environment": "development",
    "debug": true
  },
  "backend": {
    "host": "0.0.0.0",
    "port": 8000,
    "workers": 1,
    "reload": true,
    "log_level": "debug"
  },
  "frontend": {
    "port": 3000,
    "host": "localhost"
  },
  "database": {
    "type": "postgres",
    "path": "./data",
    "backup_interval": 3600
  },
  "detection": {
    "models": {
      "pose": "yolo11s-pose.pt",
      "violence": "weights/x3d_xs_violence_best.pt"
    },
    "confidence_threshold": 0.6,
    "detection_interval": 6,
    "max_unseen_frames": 150,
    "violence": {
      "model_path": "weights/x3d_xs_violence_best.pt",
      "confidence_threshold": 0.4,
      "consecutive_required": 2,
      "buffer_span": 45,
      "min_buffer_for_inference": 20,
      "check_interval": 15,
      "clip_frames": 13,
      "frame_size": 160,
      "ema_alpha": 0.35,
      "release_hysteresis_margin": 0.07,
      "bystander_merge_radius_mult": 1.3,
      "mode": "scene",
      "scene_confidence_threshold": 0.5,
      "scene_consecutive_required": 1,
      "scene_model_path": "weights/x3d_xs_violence_scene_3way_nll_scaleaug_negatives.pt",
      "_mode_options": "track | scene | tiled | both -- tiled = full camera coverage via an overlapping tile grid, for wide city cameras where a person is too small for whole-frame scene mode to see (see docs/progress_report_violence_detection.md \u00c2\u00a76). Uses scene_model_path/scene_confidence_threshold/scene_consecutive_required, same as scene mode.",
      "tile_grid": 3,
      "tile_overlap": 0.25,
      "tile_check_interval": 20
    }
  },
  "alert": {
    "enabled": true,
    "alert_duration": 90,
    "cooldown_frames": 150,
    "sound_enabled": true
  },
  "camera": {
    "index": 0,
    "source": "",
    "default_resolution": "1280x720",
    "fps": 30,
    "buffer_size": 50
  },
  "esp32": {
    "enabled": false,
    "heartbeat_interval": 30,
    "timeout": 60,
    "max_devices": 100,
    "auto_registration": true
  },
  "networking": {
    "websocket_url": "ws://backend:8000/ws",
    "api_url": "http://backend:8000",
    "timeout": 5,
    "retries": 3
  },
  "security": {
    "enable_https": false,
    "enable_cors": true,
    "cors_origins": [
      "http://localhost:3000"
    ],
    "rate_limit": {
      "enabled": false,
      "requests_per_minute": 100
    }
  },
  "monitoring": {
    "enabled": true,
    "log_file": "logs/system.log",
    "performance_tracking": true,
    "alert_log": "logs/alerts.log"
  },
  "features": {
    "real_time_monitoring": true,
    "alert_system": true,
    "device_management": true,
    "camera_integration": true,
    "esp32_support": true,
    "analytics": true,
    "export_data": true
  }
}