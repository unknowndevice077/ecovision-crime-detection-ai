{
  "name": "ecovision-security-sentinel",
  "version": "1.0.0",
  "description": "Advanced Real-Time Security Monitoring & Threat Detection System",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node tools/copy_standalone_assets.js",
    "start": "node .next/standalone/server.js",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "desktop": "electron .",
    "preapp:build": "powershell -Command \"taskkill /F /IM EcoVisionSentinel.exe /IM electron.exe 2>$null; exit 0\"",
    "app:build": "next build && node tools/copy_standalone_assets.js && electron-builder",
    "installer": "npm run app:build && powershell -ExecutionPolicy Bypass -File tools/build_sfx_installer.ps1"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "date-fns": "^2.30.0",
    "lucide-react": "^0.469.0",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "keywords": [
    "security",
    "surveillance",
    "monitoring",
    "detection",
    "threat",
    "dashboard",
    "esp32",
    "yolo",
    "ai",
    "real-time"
  ],
  "author": "EcoVision Team",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "electron": "^42.5.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.12",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "com.ecovision.sentinel",
    "productName": "EcoVisionSentinel",
    "asarUnpack": [
      "node_modules/**/*",
      ".next/**/*",
      "public/**/*",
      "package.json",
      "next.config.*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "compression": "store",
    "files": [
      "electron/**/*",
      ".next/**/*",
      "node_modules/**/*",
      "public/**/*",
      "next.config.*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "python-env",
        "to": "python-env",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "app/backend.py",
        "to": "backend/backend.py"
      },
      {
        "from": "app/db.py",
        "to": "backend/db.py"
      },
      {
        "from": "app/ptz_control.py",
        "to": "backend/ptz_control.py"
      },
      {
        "from": "app/port_utils.py",
        "to": "backend/port_utils.py"
      },
      {
        "from": "app/port_utils.py",
        "to": "maincode/port_utils.py"
      },
      {
        "from": "app/schema_final.sql",
        "to": "backend/schema_final.sql"
      },
      {
        "from": "app/schema_sqlite.sql",
        "to": "backend/schema_sqlite.sql"
      },
      {
        "from": "maincode/main.py",
        "to": "maincode/main.py"
      },
      {
        "from": "maincode/robbery_vandalism.py",
        "to": "maincode/robbery_vandalism.py"
      },
      {
        "from": "maincode/x3d_violence_detector.py",
        "to": "maincode/x3d_violence_detector.py"
      },
      {
        "from": "preflight.py",
        "to": "preflight.py"
      },
      {
        "from": "optimize_weights.py",
        "to": "optimize_weights.py"
      },
      {
        "from": "weights",
        "to": "weights",
        "filter": [
          "yolo11s-pose.pt",
          "weapons_v2.pt",
          "x3d_xs_violence_best.pt",
          "x3d_xs_violence_scene_daynight.pt",
          "x3d_xs_violence_scene_daynight.pt.meta.json",
          "x3d_xs_robbery_scene.pt",
          "x3d_xs_robbery_scene.pt.meta.json",
          "x3d_xs_vandalism_scene_v3.pt",
          "x3d_xs_vandalism_scene_v3.pt.meta.json",
          "vandalism_marks_v2.pt"
        ]
      },
      {
        "from": "config.json",
        "to": "config.json"
      },
      {
        "from": "config.production.json",
        "to": "config.production.json"
      },
      {
        "from": "requirements.txt",
        "to": "requirements.txt"
      }
    ]
  }
}
